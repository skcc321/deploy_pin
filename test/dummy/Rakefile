# frozen_string_literal: true

require_relative 'config/boot'
require 'deploy_pin'

# The deploy_pin:* tasks run the `environment` task first.
DeployPin.load_tasks

task :environment do
  require_relative 'config/environment'
end

namespace :db do
  desc 'Create the database of DB_ROLE (unless mongodb) and run the migrations'
  task :prepare do
    require_relative 'config/environment'
    Dummy::Database.prepare unless Dummy.mongoid?
  end
end
